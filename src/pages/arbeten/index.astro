---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';

const cases = (await getCollection('arbeten')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Kundcase" description="Hemsidor vi har byggt åt småföretag.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Kundcase</span>
      <h1>Sajter som <em>gör jobbet</em></h1>
      <p class="lead">Ett urval av hemsidor vi har byggt. Alla med adminverktyg, så att kunden själv håller innehållet aktuellt.</p>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="container grid grid--2" style="gap:3rem 1.5rem">
      {cases.map((c) => <CaseCard item={c} large />)}
    </div>
  </section>
</Base>
