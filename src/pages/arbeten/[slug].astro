---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';

export async function getStaticPaths() {
  const cases = (await getCollection('arbeten')).sort((a, b) => a.data.order - b.data.order);
  return cases.map((item, i) => ({
    params: { slug: item.id },
    props: { item, next: cases[(i + 1) % cases.length] },
  }));
}

interface Props { item: CollectionEntry<'arbeten'>; next: CollectionEntry<'arbeten'> }
const { item, next } = Astro.props;
const c = item.data;
const { Content } = await render(item);
---
<Base title={`${c.client} – kundcase`} description={c.excerpt}>
  <article>
    <section class="page-hero">
      <div class="container">
        <a href="/arbeten/" class="back">← Alla kundcase</a>
        <span class="eyebrow">{c.client}</span>
        <h1 class="case-title">{c.title}</h1>
        <p class="lead">{c.excerpt}</p>
        <dl class="case-facts">
          <div><dt>Bransch</dt><dd>{c.industry}</dd></div>
          <div><dt>År</dt><dd>{c.year}</dd></div>
          {c.url && <div><dt>Sajt</dt><dd><a href={c.url} target="_blank" rel="noopener">{c.url.replace(/^https?:\/\//, '').replace(/\/$/, '')} ↗</a></dd></div>}
        </dl>
      </div>
    </section>

    <div class="container">
      <img class="case-shot" src={c.image} alt={`Skärmdump av hemsidan för ${c.client}`} width="1600" height="1000" />
    </div>

    <section class="section">
      <div class="container case-body">
        <aside>
          <h2 class="case-label">Vad vi gjorde</h2>
          <ul class="tags">{c.tags.map((t) => <li class="tag">{t}</li>)}</ul>
          {c.results.length > 0 && (
            <dl class="case-results">
              {c.results.map((r) => <div><dt>{r.value}</dt><dd>{r.label}</dd></div>)}
            </dl>
          )}
        </aside>
        <div>
          <div class="prose"><Content /></div>
          {c.quote && (
            <blockquote class="case-quote">
              <p>”{c.quote}”</p>
              {c.quoteBy && <footer>{c.quoteBy}</footer>}
            </blockquote>
          )}
          <p style="margin-top:2.5rem"><a href="/bestall/" class="btn btn--accent">Vill ni ha något liknande? <span class="arrow">→</span></a></p>
        </div>
      </div>
    </section>
  </article>

  {next.id !== item.id && (
    <section class="section section--paper">
      <div class="container" style="max-width:720px">
        <span class="eyebrow">Nästa kundcase</span>
        <CaseCard item={next} large />
      </div>
    </section>
  )}
</Base>

<style>
  .back { display: inline-block; margin-bottom: 2rem; text-decoration: none; color: var(--c-muted); font-weight: 500; }
  .back:hover { color: var(--c-ink); }
  .case-title { font-size: clamp(2.2rem, 5vw, 4rem) !important; max-width: 20ch !important; }
  .case-facts { display: flex; flex-wrap: wrap; gap: 1.5rem 3rem; margin: 2rem 0 0; }
  .case-facts dt { font-size: .78rem; text-transform: uppercase; letter-spacing: .12em; color: var(--c-muted); }
  .case-facts dd { margin: .2rem 0 0; font-weight: 600; }
  .case-facts a { color: var(--c-accent-dark); text-decoration: none; }
  .case-shot { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: var(--radius); border: 1px solid var(--c-border); box-shadow: var(--shadow); background: var(--c-paper); }
  .case-body { display: grid; grid-template-columns: minmax(220px, 1fr) 2.4fr; gap: 3rem; align-items: start; }
  .case-label { font: 600 .78rem/1 var(--f-body); letter-spacing: .14em; text-transform: uppercase; color: var(--c-muted); margin-bottom: 1rem; }
  .case-results { display: grid; gap: 1.25rem; margin: 2rem 0 0; }
  .case-results dt { font: 600 2.4rem/1 var(--f-head); letter-spacing: -0.04em; color: var(--c-accent-text); }
  .case-results dd { margin: .3rem 0 0; color: var(--c-muted); }
  .case-quote { margin: 2.5rem 0 0; padding: 2rem; border-radius: var(--radius); background: var(--c-paper); border: 1px solid var(--c-border); }
  .case-quote p { margin: 0 0 1rem; font: 400 clamp(1.4rem, 2.5vw, 1.9rem)/1.3 var(--f-serif); font-style: italic; }
  .case-quote footer { color: var(--c-muted); font-weight: 500; }
  @media (max-width: 760px) { .case-body { grid-template-columns: 1fr; gap: 2rem; } }
</style>
