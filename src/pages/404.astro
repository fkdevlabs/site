---
import Base from '../layouts/Base.astro';
---
<Base title="Sidan finns inte">
  <section class="section">
    <div class="container" style="text-align:center; max-width:640px">
      <p class="serif" style="font-size:clamp(6rem,18vw,11rem); line-height:1; margin:0; color:var(--c-accent-text)">404</p>
      <h1 style="font-size:clamp(2rem,5vw,3rem)">Sidan kunde inte hittas</h1>
      <p class="lead" style="margin-inline:auto">Länken kan vara gammal, eller så har sidan flyttat.</p>
      <p style="margin-top:2rem"><a href="/" class="btn">Till startsidan</a></p>
    </div>
  </section>
</Base>
