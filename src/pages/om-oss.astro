---
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import settings from '../data/settings.json';

const { about } = settings;
const html = await marked.parse(about.text);
const initials = (name: string) => name.split(' ').map((n) => n[0]).join('').slice(0, 2).toUpperCase();
---
<Base title="Om oss" description={`Om ${settings.companyName}. ${settings.tagline}.`}>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Om oss</span>
      <h1>{about.title}</h1>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="container about">
      <div class="prose" set:html={html} />
      <ul class="people">
        {about.people.map((p: { name: string; role: string; image?: string }) => (
          <li class="person">
            {p.image ? <img src={p.image} alt={p.name} loading="lazy" /> : <span class="person__ph" aria-hidden="true">{initials(p.name)}</span>}
            <b>{p.name}</b>
            <small>{p.role}</small>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section section--paper">
    <div class="container values">
      <div><h3>Kort väg</h3><p>Ni pratar direkt med de som bygger. Inga mellanhänder, inga projektledare i flera led.</p></div>
      <div><h3>Ni äger allt</h3><p>Domän, innehåll och kod är era. Vill ni byta leverantör tar ni med er allt.</p></div>
      <div><h3>Byggt för att hålla</h3><p>Moderna, statiska sajter utan plugins som måste uppdateras. Snabbt, säkert och billigt i drift.</p></div>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .people { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1.25rem; }
  .person { display: flex; flex-direction: column; gap: .15rem; }
  .person img, .person__ph { width: 100%; aspect-ratio: 4 / 5; border-radius: var(--radius); object-fit: cover; margin-bottom: .75rem; border: 1px solid var(--c-border); }
  .person__ph { display: grid; place-items: center; background: var(--c-accent-soft); color: var(--c-accent-dark); font: 400 3.5rem/1 var(--f-serif); font-style: italic; }
  .person small { color: var(--c-muted); }
  .values { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 2rem; }
  .values p { margin: 0; color: var(--c-muted); }
  @media (max-width: 800px) { .about { grid-template-columns: 1fr; } }
</style>
